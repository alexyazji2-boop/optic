# Optic Terminal — environment. Copy to .env and fill in what you need.
#
# .env is gitignored and mode 600. Nothing in this file is a real secret; it is
# the list of names and what each one does. Set them in the Railway dashboard for
# the live site, not here.
#
# The app runs with NONE of these set. Every research endpoint answers, the
# charts draw, the screens run. What each variable adds is named below.

# ---------------------------------------------------------------- existing
# Sent as the User-Agent to SEC EDGAR, which needs a contact address and returns
# 403 from /Archives without one.
FEED_CONTACT=you@example.com

# Pulse, the assistant. Unset, Pulse reports that it needs a key and everything
# else works. Set, visitors spend your credits: see the allowance variables below.
ANTHROPIC_API_KEY=

# Gates the four endpoints that change the paper-trading record. Unset on a
# hosting platform they refuse with 503 rather than accepting anonymous writes.
# Generate with: openssl rand -hex 24
OPTIC_WRITE_TOKEN=

# Real-time option chains instead of the ~15-minute-delayed feed. Optional.
TRADIER_ACCESS_TOKEN=

# ---------------------------------------------------------------- accounts
#
# The origin the browser reaches this app on, no trailing slash. Required once a
# custom domain is attached: OAuth redirect URIs, the WebAuthn RP id and the
# links inside verification emails are all derived from it. It is configuration
# rather than a read of the Host header because a Host header is
# attacker-controlled, and a reset link built from one can be aimed elsewhere.
APP_URL=https://theopticterminal.com

# Where accounts.db lives. Defaults to $TRACKER_DATA_DIR/accounts.db, which is
# the Railway volume, so normally leave this unset.
ACCOUNTS_DB_PATH=

# Session cookie lifetime in seconds, slid forward on use. Default 30 days.
SESSION_TTL_SECONDS=2592000

# Force the Secure cookie flag on or off. Unset it decides by whether a hosting
# platform is present, which is right in both places: Secure on the live site,
# not Secure on http://localhost where the browser would silently drop it.
COOKIE_SECURE=

# --------------------------------------------------- assistant allowances
# Guests get this many assistant messages a day, so the product can be tried
# without an account. Signing in raises it to the plan's allowance (Free is 25).
GUEST_AI_CALLS_PER_DAY=5
# Burst cap per address per hour, over the top of both. 0 disables it.
AI_CALLS_PER_HOUR=30

# ------------------------------------------------------------------ google
#
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# -> Web application. Authorised redirect URI must be exactly:
#     https://theopticterminal.com/api/auth/google/callback
# Add http://localhost:8000/api/auth/google/callback as a second one for local
# work. Both buttons stay hidden until these two are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------- apple
#
# Needs a paid Apple Developer membership. developer.apple.com ->
# Certificates, Identifiers & Profiles:
#   1. Identifiers -> App IDs, enable "Sign in with Apple"
#   2. Identifiers -> Services IDs -> new -> enable Sign in with Apple.
#      Domain: theopticterminal.com
#      Return URL: https://theopticterminal.com/api/auth/apple/callback
#      That Service ID string is APPLE_CLIENT_ID.
#   3. Keys -> new key -> enable Sign in with Apple -> download the .p8 once.
#      Its id is APPLE_KEY_ID; your team id is in the top right of the portal.
# Apple requires HTTPS and a real domain, so this cannot be tested on localhost.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The whole .p8 file contents, BEGIN and END lines included. A dashboard that
# collapses newlines is fine: literal \n is accepted and converted.
APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------- passkeys
#
# Both are derived from APP_URL and normally stay unset. Set RP_ID only if the
# passkey should be bound to a parent domain (bind to example.com to have it work
# on app.example.com too). WEBAUTHN_ORIGIN takes extra comma-separated origins,
# which is what a DNS move needs so assertions from the old domain still verify.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Optic Terminal
WEBAUTHN_ORIGIN=

# -------------------------------------------------------------------- email
#
# Verification and password-reset links. With SMTP_HOST unset they are written to
# the server log instead and the UI says so rather than claiming mail was sent.
# Works with Resend, SES, Postmark, Mailgun or a Gmail app password.
# Port 465 is implicit TLS; anything else opens in the clear and upgrades with
# STARTTLS. Getting those two the wrong way round fails at connect time.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Optic Terminal

# One-time link lifetimes, in seconds.
RESET_TTL_SECONDS=900
VERIFY_TTL_SECONDS=86400
